{
  "name": "pocketscope",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^56.0.20",
    "expo-clipboard": "~56.0.4",
    "expo-dev-client": "~56.0.25",
    "expo-font": "~56.0.7",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "sync:startpage": "node -e \"const fs=require('fs');fs.writeFileSync('startpage.js','// GENERATED from docs/index.html - run npm run sync:startpage after editing that file.\\nexport default '+JSON.stringify(fs.readFileSync('docs/index.html','utf8'))+';\\n')\"",
    "emu": "ANDROID_HOME=/opt/homebrew/share/android-commandlinetools /opt/homebrew/share/android-commandlinetools/emulator/emulator -avd ps -no-snapshot-save -no-audio -gpu swiftshader_indirect",
    "emu:install": "/opt/homebrew/share/android-commandlinetools/platform-tools/adb install -r",
    "shot": "/opt/homebrew/share/android-commandlinetools/platform-tools/adb shell screencap -p /sdcard/s.png && /opt/homebrew/share/android-commandlinetools/platform-tools/adb pull /sdcard/s.png ./shot.png"
  },
  "private": true
}
